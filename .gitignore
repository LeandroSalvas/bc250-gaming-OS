# Ignorar arquivos de ISO e builds (não fazer commit)
*.iso
work/
out/
localrepo/
.build/
*.tar.zst
*.pkg.tar.zst
*.db.tar.gz
*.files.tar.gz

# Diretórios de build do makepkg dentro de pkgbuilds/
pkgbuilds/*/src/
pkgbuilds/*/pkg/
pkgbuilds/*/*/

# Logs e temporários
*.log
*.tmp

# Cache/lock do pacman
.pacman-db.lock
