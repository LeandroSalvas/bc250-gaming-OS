# Maintainer: Projeto BC-250 <bc250@projetobc250.local>
pkgname=bc250-smu-oc
pkgver=1.0
pkgrel=1
pkgdesc="Overclock SMU para APU AMD BC-250"
arch=('x86_64')
url="https://github.com/bc250-collective/bc250_smu_oc"
license=('GPL2')

depends=(
    'linux'
    'linux-headers'
)

makedepends=(
    'git'
    'make'
)

source=(
    "git+https://github.com/bc250-collective/bc250_smu_oc.git"
)

sha256sums=(
    'SKIP'
)

package() {
    cd "${srcdir}/bc250_smu_oc"
    
    # Install SMU overclock utility
    mkdir -p "${pkgdir}/usr/local/bin"
    install -Dm755 bc250-smu-oc "${pkgdir}/usr/local/bin/bc250-smu-oc"
    
    # Install configuration profiles
    mkdir -p "${pkgdir}/etc/bc250"
    install -Dm644 profiles.conf "${pkgdir}/etc/bc250/profiles.conf"
    install -Dm644 default.profile "${pkgdir}/etc/bc250/default.profile"
    
    # Install license
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
