# Maintainer: Projeto BC-250 <bc250@projetobc250.local>
pkgname=bc250-memory-temperature
pkgver=1.0
pkgrel=1
pkgdesc="Módulo de temperatura de memória para APU AMD BC-250"
arch=('x86_64')
url="https://github.com/pan-Rijovich/bc250-memory-temperature"
license=('GPL2')

depends=(
    'lm-sensors'
    'linux'
    'linux-headers'
)

makedepends=(
    'git'
)

source=(
    "git+https://github.com/pan-Rijovich/bc250-memory-temperature.git"
)

sha256sums=(
    'SKIP'
)

package() {
    cd "${srcdir}/bc250-memory-temperature"
    
    # Install temperature monitoring tool
    mkdir -p "${pkgdir}/usr/local/bin"
    install -Dm755 bc250-memory-temperature "${pkgdir}/usr/local/bin/bc250-memory-temperature"
    
    # Install sensor config
    mkdir -p "${pkgdir}/etc/sensors.d"
    install -Dm644 config "${pkgdir}/etc/sensors.d/bc250.conf"
    
    # Install license
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    
    # Install systemd service for auto-start
    mkdir -p "${pkgdir}/usr/lib/systemd/system"
    install -Dm644 bc250-memory-temperature.service "${pkgdir}/usr/lib/systemd/system/bc250-memory-temperature.service"
}
